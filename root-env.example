# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/student-placement-tracker

# Client (for CORS)
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Required to register a new user as Admin. Keep this secret — only share it
# with people who should have admin access. Anyone without this code will
# always be registered as a student, regardless of what they select.
ADMIN_INVITE_CODE=set_a_secret_code_here
